<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-Bike Weather &amp; Tracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSetHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Home to Current Location (150m Radius)" />

        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Home Location: Not Set"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rain Severity Score Threshold (10-100)" />

        <EditText
            android:id="@+id/etPrecipProb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g., 55" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Save Parameters" />

        <Button
            android:id="@+id/btnRainScoreExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="How the Rain Score Works" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66888888"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Battery, Odometer & Total Analytics Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATTERY, ODOMETER &amp; TOTAL ANALYTICS"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvOdometer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Distance since last charge: 0.0 miles"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChargeAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Average between charges: -- miles"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChargeHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Past charges: None recorded yet"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvAllTimeAnalytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All-Time Total: 0.00 mi (0 rides) • Avg: 0.0 mph • Max: 0.0 mph"
                android:textColor="#93C5FD"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnResetOdometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋 I Just Charged My Bike (Log &amp; Reset)" />

        <Button
            android:id="@+id/btnViewRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🗺️ View Ride Map &amp; Past Rides" />

    </LinearLayout>
</ScrollView>
