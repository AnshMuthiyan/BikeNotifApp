<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="E-Bike Weather Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSetHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Set Home to Current Location (100m Radius)" />

    <TextView
        android:id="@+id/tvCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home Location: Not Set"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rain Severity Score Threshold (0-100)" />

    <EditText
        android:id="@+id/etPrecipProb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="e.g., 30" />

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Save Parameters" />

    <Button
        android:id="@+id/btnRainScoreExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="How the Rain Score Works" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvOdometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Distance since last charge: 0.0 miles"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnResetOdometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="I Just Charged My Bike (Reset)" />

    <Button
        android:id="@+id/btnViewRide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="View Latest Ride Details" />

</LinearLayout>